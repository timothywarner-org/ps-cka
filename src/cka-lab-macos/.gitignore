# Vagrant VM state (never commit — contains auto-generated keys, VM GUIDs)
.vagrant/

# VM disk images and snapshots (blocked by repo root .gitignore too)
*.vmdk
*.vmwarevm/
*.vmx
*.vmxf
*.nvram
*.vmem
*.vmss
*.vmsn
*.log

# Temp and personal files
temp/
*.log
.env
.env.*

# SSH keys (auto-generated by Vagrant, not for source control)
*.pem
*.key
*.crt
*.pfx
kubeconfig
*.kubeconfig

# Editor scratch files
.idea/
.vscode/
*.swp
*~
